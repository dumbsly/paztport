<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.paztport</groupId>
    <artifactId>paztport-sdk-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Paztport Java SDK Parent</name>
    <description>Path attestation proof of concept: a request proves the route it took.</description>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>The Paztport Authors</name>
    </organization>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>core</module>
        <module>http</module>
        <module>spring</module>
        <module>tools/keygen</module>
        <module>tools/policy-tool</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.boot.version>4.1.1</spring.boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Manages the SDK's Jackson 2 (com.fasterxml.jackson, which it reads and canonicalises
                 JSON with inside; no public signature names it), the Jackson 3 that Spring MVC uses, and
                 JUnit. None is pinned beside it: a BOM imported after this one loses to it, and a single
                 pinned Jackson module would split Jackson 2 across two lines. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <!-- The version Maven binds by default, pinned because core, http and spring configure it
                     to name their module in the manifest. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Lists this tree's runtime dependencies in target/THIRD-PARTY.txt:
                   mvn license:aggregate-add-third-party
                 poc-sdks/scripts/third-party.sh runs it here and in the demo, then merges
                 both lists into the root THIRD-PARTY.txt. Not bound to a phase, so normal
                 builds don't run it. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>2.4.0</version>
                <inherited>false</inherited>
                <configuration>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                    <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
                    <excludedScopes>test,system,provided</excludedScopes>
                    <excludedGroups>^org\.paztport</excludedGroups>
                    <sortArtifactByName>true</sortArtifactByName>
                    <licenseMerges>
                        <licenseMerge>Apache-2.0|Apache License, Version 2.0|The Apache Software License, Version 2.0|Apache License 2.0|Apache 2.0</licenseMerge>
                        <licenseMerge>MIT|MIT License|The MIT License</licenseMerge>
                    </licenseMerges>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
