<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.paztport</groupId>
        <artifactId>paztport-sdk-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>paztport-spring</artifactId>
    <name>Paztport Spring</name>
    <description>Inbound verification filter and outbound stamping interceptor for Spring Boot.</description>

    <dependencies>
        <dependency>
            <groupId>org.paztport</groupId>
            <artifactId>paztport-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.paztport</groupId>
            <artifactId>paztport-http</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <!-- RestClientCustomizer, through which the starter fits the application's RestClient.Builder
                 with the stamping interceptor and the pooled TLS client. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <dependency>
            <!-- ObservationRegistry, in which the filters and the interceptor record each verification result.
                 An application without a registry passes ObservationRegistry.NOOP. -->
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-observation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Test code only: TestObservationRegistry, to read the observations the filters record. -->
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-observation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Test code only: Boot's own observation and metrics auto-configurations, to prove that the starter's
                 observations become meters in Boot's registry. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-observation</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-metrics</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Test code only: the scrape format, to show the series name the demos read. -->
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Test code only: reads the JSON the tests send and receive. The SDK reads and writes JSON itself. -->
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The silent peer the HTTP module's tests also use. -->
        <dependency>
            <groupId>org.paztport</groupId>
            <artifactId>paztport-http</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Since JDK 23 javac runs annotation processors only when asked; naming the configuration processor
                 on the processor path asks for it. It writes META-INF/spring-configuration-metadata.json from
                 PaztportProperties, so IDEs complete and describe the paztport.* properties. It is no dependency
                 of this module, so it stays out of the third-party list. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring.boot.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Mockito attaches byte-buddy's agent at runtime. Allowing that up front keeps the JVM's
                 warning about it out of the test output; class sharing is off because the agent extends
                 the boot class path, which class sharing would otherwise warn about. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
                </configuration>
            </plugin>
            <!-- A stable module name for module-path users, from the root package. There is no
                 module-info.java: Spring applications run on the class path. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>org.paztport.spring</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
