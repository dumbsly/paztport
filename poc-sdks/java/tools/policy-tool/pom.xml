<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.paztport</groupId>
        <artifactId>paztport-sdk-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>policy-tool</artifactId>
    <name>Policy Tool</name>
    <description>CLI: paths.yaml to a signed Merkle root and per-service proof bundles.</description>

    <dependencies>
        <dependency>
            <groupId>org.paztport</groupId>
            <artifactId>paztport-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Test code only: reads the files the tool writes. The SDK reads and writes JSON itself. -->
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- META-INF/THIRD-PARTY.txt and META-INF/licenses/ for what the jar bundles (set up in the parent). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
            </plugin>
            <!-- The module jar holds the tool's own classes and bundles nothing, so it leaves out the bundled
                 components' list and licence texts; the shaded jar below adds them. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>META-INF/THIRD-PARTY.txt</exclude>
                        <exclude>META-INF/licenses/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Separate output file, so a rebuild never re-shades the fat jar. -->
                            <outputFile>${project.build.directory}/policy-tool.jar</outputFile>
                            <filters>
                                <!-- Paztport's own libraries carry the same NOTICE as this jar. -->
                                <filter>
                                    <artifact>org.paztport:paztport-*</artifact>
                                    <excludes>
                                        <exclude>META-INF/NOTICE</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.paztport.policy.PolicyToolMain</mainClass>
                                </transformer>
                                <!-- Drops every bundled META-INF/LICENSE, LICENSE.txt and LICENSE.md, and puts the root
                                     LICENSE back: META-INF/THIRD-PARTY.txt names each bundled component's licence, and
                                     META-INF/licenses/ holds every text other than Apache-2.0's. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                    <resource>META-INF/LICENSE</resource>
                                    <file>${paztport.root}/LICENSE</file>
                                </transformer>
                                <!-- This jar's NOTICE, Paztport's, followed by the NOTICE of each bundled component
                                     that has one. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/NOTICE</resource>
                                </transformer>
                                <!-- What this jar bundles, from the license plugin. Every component is Apache-2.0, whose
                                     text is META-INF/LICENSE, so there is no other licence text to add. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                    <resource>META-INF/THIRD-PARTY.txt</resource>
                                    <file>${project.build.directory}/third-party/META-INF/THIRD-PARTY.txt</file>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
