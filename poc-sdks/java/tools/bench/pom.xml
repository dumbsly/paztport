<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.paztport</groupId>
        <artifactId>paztport-sdk-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>bench</artifactId>
    <name>Bench</name>
    <description>JMH micro-benchmarks of the primitives a verifying hop pays for: the Merkle proof walk, the request binding and Ed25519.</description>

    <properties>
        <jmh.version>1.37</jmh.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.paztport</groupId>
            <artifactId>paztport-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- The request binding, computed as a calling service computes it. -->
            <groupId>org.paztport</groupId>
            <artifactId>paztport-http</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- The benchmark harness. Bench only: the SDK needs none. -->
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- JMH generates its harness classes and META-INF/BenchmarkList with an annotation processor. Since
                     JDK 23 javac runs no processor it was not given, so it is named here. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Separate output file, so a rebuild never re-shades the fat jar. -->
                            <outputFile>${project.build.directory}/bench.jar</outputFile>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                </transformer>
                                <!-- Keep one Apache LICENSE and merge the Apache NOTICEs. JMH's licence (GPLv2 with the Classpath Exception) and the others are listed in THIRD-PARTY.txt. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                                    <projectName>Paztport</projectName>
                                    <organizationName>The Paztport Authors</organizationName>
                                    <inceptionYear>2026</inceptionYear>
                                    <preamble3 xml:space="preserve">Released under the Apache License, Version 2.0, by </preamble3>
                                    <organizationURL>https://www.apache.org/licenses/LICENSE-2.0</organizationURL>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                    <resource>META-INF/LICENSE</resource>
                                    <file>${project.basedir}/../../../../LICENSE</file>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
