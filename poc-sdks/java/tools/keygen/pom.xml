<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.paztport</groupId>
        <artifactId>paztport-sdk-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>keygen</artifactId>
    <name>Keygen</name>
    <description>One-shot CLI: per-service Ed25519 keypairs, a signed keyring and policy pin, and a certificate authority with TLS certificates.</description>

    <dependencies>
        <dependency>
            <groupId>org.paztport</groupId>
            <artifactId>paztport-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- Builds the X.509 certificates; the JDK has no public API for it. Keygen only: the SDK needs none. -->
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.80</version>
        </dependency>
        <dependency>
            <!-- bcpkix 1.80 would pull 1.80.2 of these two; pinned to 1.80, as the mesh demo does, so one version ships. -->
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcutil-jdk18on</artifactId>
            <version>1.80</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.80</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- META-INF/THIRD-PARTY.txt and META-INF/licenses/ for what the jar bundles (set up in the parent). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Separate output file, so a rebuild never re-shades the fat jar. -->
                            <outputFile>${project.build.directory}/keygen.jar</outputFile>
                            <filters>
                                <!-- Bouncy Castle's jars are signed; copied into a fat jar the signatures no longer match. -->
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                                <!-- Paztport's own libraries carry the same NOTICE as this jar. -->
                                <filter>
                                    <artifact>org.paztport:paztport-*</artifact>
                                    <excludes>
                                        <exclude>META-INF/NOTICE</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.paztport.keygen.KeygenMain</mainClass>
                                </transformer>
                                <!-- Drops every bundled META-INF/LICENSE, LICENSE.txt and LICENSE.md, and puts the root
                                     LICENSE back: META-INF/THIRD-PARTY.txt names each bundled component's licence, and
                                     META-INF/licenses/ holds every text other than Apache-2.0's. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                    <resource>META-INF/LICENSE</resource>
                                    <file>${paztport.root}/LICENSE</file>
                                </transformer>
                                <!-- This jar's NOTICE, Paztport's, followed by the NOTICE of each bundled component
                                     that has one. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/NOTICE</resource>
                                </transformer>
                                <!-- Merges ServiceLoader registrations: Bouncy Castle registers its
                                     java.security.Provider there. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
