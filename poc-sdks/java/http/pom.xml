<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.paztport</groupId>
        <artifactId>paztport-sdk-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>paztport-http</artifactId>
    <name>Paztport HTTP</name>
    <description>v3 over HTTP, no web framework: codecs, receivers, session registry, request context.</description>

    <dependencies>
        <dependency>
            <groupId>org.paztport</groupId>
            <artifactId>paztport-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <!-- The facade only: the event publishers and the trace lines log through it, and the
                 application chooses what backs it. -->
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The egress's tests, moved from the starter, assert with it. -->
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Core's vector loader and public-API walk. -->
        <dependency>
            <groupId>org.paztport</groupId>
            <artifactId>paztport-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Captures the publishers' log lines. -->
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- A stable module name for module-path users, from the root package. There is no
                 module-info.java: Spring applications run on the class path. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>org.paztport.http</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
                <!-- The test jar shares with the starter's tests only what they use: the silent peer, which
                     stalls the egress and the events the same way, and the bridges to the event timeout and the
                     request trace line. Nothing in it can mark a chain verified; the starter keeps that bridge in
                     its own test sources. -->
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>org/paztport/http/SilentPeer*.class</include>
                                <include>org/paztport/http/StubPartner*.class</include>
                                <include>org/paztport/http/BoundaryAccess.class</include>
                                <include>org/paztport/http/ReceiverAccess.class</include>
                                <include>org/paztport/http/TraceAccess.class</include>
                                <include>org/paztport/http/event/EventAccess.class</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
