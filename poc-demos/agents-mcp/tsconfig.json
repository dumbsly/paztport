{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["mock-github-mcp/src", "mock-github-mcp/test", "pi-extension/src", "pi-extension/test", "eval/src", "eval/test", "demo-ui/src", "demo-ui/test", "scripts", "vitest.config.ts"]
}
