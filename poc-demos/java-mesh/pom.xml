<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The SDK's parent, for the build both trees share: the compiler, the Spring Boot BOM, LICENSE and NOTICE
         in every jar, and the licence settings. An application using the SDK needs only its dependencies. -->
    <parent>
        <groupId>org.paztport</groupId>
        <artifactId>paztport-sdk-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../poc-sdks/java/pom.xml</relativePath>
    </parent>

    <artifactId>paztport-java-mesh-parent</artifactId>
    <packaging>pom</packaging>

    <name>Paztport Java Mesh Demo Parent</name>
    <description>The Java mesh demo: the shop's Spring Boot services and a quarantine responder on the Paztport SDK, and a partner organisation's PSP.</description>

    <modules>
        <module>services/gateway</module>
        <module>services/orders</module>
        <module>services/payment</module>
        <module>services/search</module>
        <module>services/tickets</module>
        <module>services/assistant</module>
        <module>services/mailer</module>
        <module>responder</module>
        <module>psp</module>
    </modules>

    <properties>
        <!-- The SDK release the demo builds against; install it first with
             `mvn install` in poc-sdks/java. -->
        <paztport.sdk.version>0.1.0-SNAPSHOT</paztport.sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- docker-java 3.7.1 (responder only) still pulls in older releases of these than the ones
                 pinned here (Guava 33.4.8-jre, Commons IO 2.21.0, Bouncy Castle 1.82), and Spring Boot
                 manages none of them, so the later releases are pinned. It brings Commons Compress 1.28.0, so
                 that one needs no pin. -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.8.0-jre</version>
            </dependency>
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.22.0</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>1.86</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>1.86</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcutil-jdk18on</artifactId>
                <version>1.86</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Each app's jar holds Spring Boot's launcher classes at its root, unpacked rather than nested, so the
             loader is declared for the jar's THIRD-PARTY.txt and NOTICE. Optional: repackage leaves it out of
             BOOT-INF/lib. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-loader</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Mockito attaches byte-buddy's agent at runtime: the quarantiner's tests mock the Docker
                     client with it, and Spring's test support starts it to reset mocks before and after each
                     Spring test, whether or not that test mocks anything. Allowing the agent up front keeps the
                     JVM's warning about it, and Mockito's own, out of the test output; class sharing is off
                     because the agent extends the boot class path. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>-XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
                    </configuration>
                </plugin>
                <!-- Each module is a Boot app: it declares this plugin, maven-antrun-plugin and
                     license-maven-plugin. -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.version}</version>
                    <configuration>
                        <!-- The images run java -jar and nothing extracts layers, so the jar leaves out the
                             layer tools. -->
                        <includeTools>false</includeTools>
                    </configuration>
                </plugin>
                <!-- Every app bundles Logback and Jakarta Annotations, and responder JNA, each under the licence
                     licenses/overrides.properties elects. -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>license-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>bundled-licences</id>
                            <configuration>
                                <overrideUrl>file://${paztport.root}/licenses/overrides.properties</overrideUrl>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <!-- The app's NOTICE: Paztport's, then Spring Boot's from the loader, whose classes the jar holds
                     unpacked. The libraries in BOOT-INF/lib are nested whole and keep their own NOTICE files. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>notice</id>
                            <phase>prepare-package</phase>
                            <goals>
                                <goal>run</goal>
                            </goals>
                            <configuration>
                                <target>
                                    <concat destfile="${project.build.outputDirectory}/META-INF/NOTICE" fixlastline="yes">
                                        <file file="${paztport.root}/NOTICE"/>
                                        <string value="&#10;"/>
                                        <zipentry zipfile="${org.springframework.boot:spring-boot-loader:jar}"
                                                  name="META-INF/NOTICE.txt"/>
                                    </concat>
                                </target>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
