<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.paztport</groupId>
        <artifactId>paztport-java-mesh-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>responder</artifactId>
    <name>Responder</name>
    <description>Quarantine controller: counts rejection events and isolates/replaces offending containers.</description>

    <properties>
        <docker-java.version>3.4.0</docker-java.version>
        <unsafeMemoryAccess></unsafeMemoryAccess>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.paztport</groupId>
            <artifactId>paztport-core</artifactId>
            <version>${paztport.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.docker-java</groupId>
            <artifactId>docker-java-core</artifactId>
            <version>${docker-java.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.docker-java</groupId>
            <artifactId>docker-java-transport-zerodep</artifactId>
            <version>${docker-java.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>responder</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- The quarantiner's tests mock the Docker client with Mockito, which attaches byte-buddy's agent
                 at runtime. This byte-buddy predates the newest JDKs, so it is told to accept their class
                 files. Allowing the agent and its use of sun.misc.Unsafe up front keeps the JVM's warnings
                 out of the test output; class sharing is off because the agent extends the boot class path. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dnet.bytebuddy.experimental=true -XX:+EnableDynamicAgentLoading -Xshare:off ${unsafeMemoryAccess}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The flag that allows sun.misc.Unsafe is unknown to JDK 21, so it is only passed where it exists. -->
        <profile>
            <id>unsafe-memory-access</id>
            <activation>
                <jdk>[23,)</jdk>
            </activation>
            <properties>
                <unsafeMemoryAccess>--sun-misc-unsafe-memory-access=allow</unsafeMemoryAccess>
            </properties>
        </profile>
    </profiles>
</project>
