<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2026 The Paztport Authors
     SPDX-License-Identifier: Apache-2.0

     Read by license-maven-plugin download-licenses (licensesConfigFile) before it copies the licence texts a
     bundling jar needs into its META-INF/licenses/. An entry replaces the licences of the components it matches;
     a URL licenses:<file> names a text in this directory. -->
<licenseSummary>
    <dependencies>
        <!-- Apache-2.0: the jar's META-INF/LICENSE holds the text, so none is copied. The names are the ones the
             poms' licenseMerges fold into Apache-2.0. -->
        <dependency>
            <groupId>.*</groupId>
            <artifactId>.*</artifactId>
            <matchLicenses>
                <license>
                    <name>Apache-2\.0|Apache License, Version 2\.0|The Apache Software License, Version 2\.0|The Apache License, Version 2\.0|Apache License 2\.0|Apache 2\.0</name>
                    <url>.*</url>
                    <distribution>.*</distribution>
                    <comments>(?s).*</comments>
                </license>
            </matchLicenses>
            <licenses>
                <license>
                    <name>Apache-2.0</name>
                </license>
            </licenses>
        </dependency>

        <!-- MIT names its copyright holder, so each holder's components get that holder's text. -->
        <dependency>
            <groupId>org\.slf4j</groupId>
            <artifactId>.*</artifactId>
            <matchLicenses>
                <license>
                    <name>MIT</name>
                    <url>.*</url>
                    <distribution>.*</distribution>
                </license>
            </matchLicenses>
            <licenses>
                <license>
                    <name>MIT</name>
                    <url>licenses:mit-slf4j.txt</url>
                </license>
            </licenses>
        </dependency>
        <dependency>
            <groupId>org\.checkerframework</groupId>
            <artifactId>checker-qual</artifactId>
            <matchLicenses>
                <license>
                    <name>MIT</name>
                    <url>.*</url>
                    <distribution>.*</distribution>
                </license>
            </matchLicenses>
            <licenses>
                <license>
                    <name>MIT</name>
                    <url>licenses:mit-checker-framework.txt</url>
                </license>
            </licenses>
        </dependency>

        <!-- The elected licence of each dual-licensed component, as in overrides.properties. Each entry matches
             that version and its two licences, so a component whose version or licences change stops matching,
             and the build fails on the licence URLs its pom names. -->
        <dependency>
            <groupId>ch\.qos\.logback</groupId>
            <artifactId>logback-classic|logback-core</artifactId>
            <version>1\.5\.38</version>
            <matchLicenses>
                <license>
                    <name>EPL-2\.0</name>
                    <url>.*</url>
                    <comments>(?s).*</comments>
                </license>
                <license>
                    <name>LGPL-2\.1-only</name>
                    <url>.*</url>
                    <comments>(?s).*</comments>
                </license>
            </matchLicenses>
            <licenses>
                <license>
                    <name>EPL-2.0</name>
                    <url>licenses:epl-2.0.txt</url>
                </license>
            </licenses>
        </dependency>
        <dependency>
            <groupId>jakarta\.annotation</groupId>
            <artifactId>jakarta\.annotation-api</artifactId>
            <version>3\.0\.0</version>
            <matchLicenses>
                <license>
                    <name>EPL 2\.0</name>
                    <url>.*</url>
                    <distribution>.*</distribution>
                </license>
                <license>
                    <name>GPL2 w/ CPE</name>
                    <url>.*</url>
                    <distribution>.*</distribution>
                </license>
            </matchLicenses>
            <licenses>
                <license>
                    <name>EPL-2.0</name>
                    <url>licenses:epl-2.0.txt</url>
                </license>
            </licenses>
        </dependency>
        <dependency>
            <groupId>net\.java\.dev\.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5\.13\.0</version>
            <matchLicenses>
                <license>
                    <name>LGPL-2\.1-or-later</name>
                    <url>.*</url>
                    <distribution>.*</distribution>
                    <comments>(?s).*</comments>
                </license>
                <license>
                    <name>Apache-2\.0</name>
                    <url>.*</url>
                    <distribution>.*</distribution>
                    <comments>(?s).*</comments>
                </license>
            </matchLicenses>
            <licenses>
                <license>
                    <name>Apache-2.0</name>
                </license>
            </licenses>
        </dependency>
    </dependencies>
</licenseSummary>
