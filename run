#!/usr/bin/env bash
# Copyright 2026 The Paztport Authors
# SPDX-License-Identifier: Apache-2.0
#
# The front door: check prerequisites, build what the demos need, and run them or every suite.
set -euo pipefail
cd "$(dirname "$0")"

usage() {
  cat <<'USAGE'
Usage: ./run <command> [options]

  java-mesh    Build the Java SDK and the mesh demo, then run poc-demos/java-mesh/demo.sh (needs Docker).
  envoy-gateway
               Make the edge's keys and policy, for the Envoy Gateway proof of concept on a local kind
               cluster (needs Docker, kind, kubectl and helm; see poc-demos/envoy-gateway/README.md).
  agents-mcp   Install the TypeScript SDK and the agents demo, set up demo keys, and start the demo page.
  test         The name and link checks, the Java SDK and Java demo suites, a check of what the built jars
               carry, the TypeScript type checks and the TypeScript SDK and demo suites, then gofmt, go vet
               and the Go SDK's suite. No Docker and no model.
  bench        Build the Java SDK's benchmarks and time the primitives a verifying hop pays for (JMH, a few
               minutes), on the JDK Maven uses. Options after it go to JMH, e.g. ./run bench -f 3; JMH's own
               help is ./run bench -h. Not part of test.

macOS and Linux; on Windows use WSL.
USAGE
}

# missing <tool> <min version> <where to get it>: one line, then stop before anything is built.
missing() {
  echo "missing: $1 $2 — $3"
  exit 1
}

# at_least <found> <minimum>: true when the dotted version `found` is >= `minimum`.
at_least() {
  [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1)" = "$2" ]
}

need_java() {
  # Maven decides which JDK builds the code (JAVA_HOME, PATH, platform lookups), so ask Maven, not PATH.
  # A failing `mvn -v` leaves the version empty and reaches the missing: line instead of ending the script.
  command -v mvn >/dev/null 2>&1 || missing mvn 3.9 "https://maven.apache.org/download.cgi or your package manager"
  local version major
  version="$(mvn -v 2>/dev/null || true)"
  major="$(sed -n 's/^Java version: \([0-9]*\).*/\1/p' <<<"$version" | head -n1 || true)"
  [ -n "$major" ] && [ "$major" -ge 25 ] || missing java 25 "https://adoptium.net or your package manager (mvn -v must report Java 25+)"
  # The same JDK runs the built jars, since the java on PATH may be a different one or none.
  maven_java="$(sed -n 's/.*, runtime: \(.*\)$/\1/p' <<<"$version" | head -n1 || true)/bin/java"
}

need_node() {
  command -v node >/dev/null 2>&1 || missing node 22.19 "https://nodejs.org"
  at_least "$(node -v | sed 's/^v//')" 22.19 || missing node 22.19 "https://nodejs.org"
  command -v npm >/dev/null 2>&1 || missing npm 10 "https://nodejs.org (it ships with node)"
}

need_unzip() {
  # The jar check reads the built jars with it.
  command -v unzip >/dev/null 2>&1 || missing unzip 6 "your package manager"
}

need_go() {
  # The module's go line is the oldest Go that builds it. Checked here, outside the module, because inside it
  # an older go may fetch a newer toolchain instead of stopping.
  local want found
  want="$(sed -n 's/^go \([0-9]*\.[0-9]*\).*/\1/p' poc-sdks/go/go.mod)"
  command -v go >/dev/null 2>&1 || missing go "$want" "https://go.dev/dl or your package manager"
  found="$(go version 2>/dev/null | sed -n 's/^go version go\([0-9.]*\).*/\1/p' || true)"
  [ -n "$found" ] && at_least "$found" "$want" || missing go "$want" "https://go.dev/dl or your package manager"
}

need_docker() {
  command -v docker >/dev/null 2>&1 || missing docker 24 "https://docs.docker.com/get-docker/"
  docker info >/dev/null 2>&1 || missing docker 24 "start the Docker daemon (docker info must succeed)"
}

# The cluster tools of the Envoy Gateway proof of concept. Each minimum is the lowest the scaffold is written for:
# kind 0.33 (the cluster and node image are pinned to it), kubectl 1.33 and helm 3.17 (the commands it runs).
# tool_version <pattern> <command...>: the first dotted version the command prints, or nothing.
tool_version() {
  local pattern="$1"
  shift
  "$@" 2>/dev/null | sed -n "s/.*$pattern *v\{0,1\}\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p" | head -n1 || true
}

need_kind() {
  local found
  command -v kind >/dev/null 2>&1 || missing kind 0.33 "https://kind.sigs.k8s.io/docs/user/quick-start/#installation"
  found="$(tool_version kind kind version)"
  [ -n "$found" ] && at_least "$found" 0.33 || missing kind 0.33 "https://kind.sigs.k8s.io/docs/user/quick-start/#installation"
}

need_kubectl() {
  local found
  command -v kubectl >/dev/null 2>&1 || missing kubectl 1.33 "https://kubernetes.io/docs/tasks/tools/ or your package manager"
  found="$(tool_version 'Client Version:' kubectl version --client)"
  [ -n "$found" ] && at_least "$found" 1.33 || missing kubectl 1.33 "https://kubernetes.io/docs/tasks/tools/ or your package manager"
}

need_helm() {
  local found
  command -v helm >/dev/null 2>&1 || missing helm 3.17 "https://helm.sh/docs/intro/install/ or your package manager"
  found="$(tool_version '' helm version --template '{{.Version}}')"
  [ -n "$found" ] && at_least "$found" 3.17 || missing helm 3.17 "https://helm.sh/docs/intro/install/ or your package manager"
}

install_ts_sdk() {
  # The demos link the SDK packages with file: paths, and those packages resolve their own dependencies only
  # from the SDK workspace, so the SDK is installed first.
  (cd poc-sdks/typescript && npm install --no-audit --no-fund)
}

install_ts_demo() {
  (cd poc-demos/agents-mcp && npm install --no-audit --no-fund)
}

report_ollama() {
  if curl -s -m 2 -o /dev/null http://localhost:11434; then
    echo "ollama: reachable at http://localhost:11434 (pi picks its provider; this script never does)"
  else
    echo "ollama: unreachable at http://localhost:11434 (pi picks its provider; this script never does)"
  fi
}

# The Go SDK's checks: formatting, vet, then its tests.
test_go() (
  cd poc-sdks/go
  local unformatted
  unformatted="$(gofmt -l .)"
  [ -z "$unformatted" ] || { printf 'gofmt would change:\n%s\n' "$unformatted"; exit 1; }
  go vet ./...
  go test -count=1 ./...
)

cmd_java_mesh() {
  need_java
  need_docker
  (cd poc-sdks/java && mvn -q install -DskipTests)
  (cd poc-demos/java-mesh && mvn -q package -DskipTests)
  exec poc-demos/java-mesh/demo.sh
}

cmd_envoy_gateway() {
  need_java
  need_docker
  need_go
  need_kind
  need_kubectl
  need_helm
  # The tool jars make the keys and the signed policy; they are built here and run on the JDK Maven uses.
  (cd poc-sdks/java && mvn -q install -DskipTests)
  PAZTPORT_JAVA="$maven_java" exec poc-demos/envoy-gateway/material.sh
}

cmd_agents_mcp() {
  need_node
  install_ts_sdk
  install_ts_demo
  if [ ! -d poc-demos/agents-mcp/.demo ]; then
    (cd poc-demos/agents-mcp && npm run setup-demo)
  fi
  report_ollama
  cd poc-demos/agents-mcp
  exec npm run demo
}

cmd_bench() {
  need_java
  [ -x "$maven_java" ] || missing java 25 "https://adoptium.net or your package manager (mvn -v must report the JDK's runtime)"
  # JMH is on the class path, not in a jar; its forks inherit it. The reactor build resolves the SDK modules'
  # jars, so the class path file is read from the bench module's target/.
  (cd poc-sdks/java && mvn -q package dependency:build-classpath -DskipTests -Dmdep.outputFile=target/bench.classpath -pl tools/bench -am)
  bench_dir=poc-sdks/java/tools/bench/target
  exec "$maven_java" -cp "$bench_dir/classes:$(cat "$bench_dir/bench.classpath")" org.openjdk.jmh.Main "$@"
}

cmd_test() {
  need_unzip
  need_go
  need_java
  need_node
  [ -x "$maven_java" ] || missing java 25 "https://adoptium.net or your package manager (mvn -v must report the JDK's runtime)"
  bash poc-sdks/scripts/check-names.sh
  node poc-sdks/scripts/check-links.mjs
  (cd poc-sdks/java && mvn -q install)
  (cd poc-demos/java-mesh && mvn -q verify)
  bash poc-sdks/scripts/check-artefacts.sh
  # The TS and Go SDKs' cross-language checks read a keyring the Java keygen writes, so they run here instead of
  # skipping.
  test_keys="$(mktemp -d)"
  trap 'rm -rf "$test_keys"' EXIT
  "$maven_java" -jar poc-sdks/java/tools/keygen/target/keygen.jar "$test_keys" >/dev/null
  install_ts_sdk
  install_ts_demo
  # Type-check both workspaces first: vitest strips types, so type-level guards hold only under tsc.
  (cd poc-sdks/typescript && npm run -s check)
  (cd poc-demos/agents-mcp && npm run -s check)
  (cd poc-sdks/typescript && PAZTPORT_JAVA_KEYRING="$test_keys/keyring.json" npm test)
  (cd poc-demos/agents-mcp && npm test)
  PAZTPORT_JAVA_KEYRING="$test_keys/keyring.json" test_go
  echo "all suites passed"
}

# -h after a command prints this usage, except after bench, whose options all go to JMH.
[ "${1:-}" = bench ] || case "${2:-}" in
  -h|--help) usage; exit 0 ;;
esac

case "${1:-}" in
  java-mesh) cmd_java_mesh ;;
  agents-mcp) cmd_agents_mcp ;;
  envoy-gateway) cmd_envoy_gateway ;;
  test) cmd_test ;;
  bench) shift; cmd_bench "$@" ;;
  -h|--help|help) usage ;;
  "") usage ;;
  *) usage >&2; exit 2 ;;
esac
